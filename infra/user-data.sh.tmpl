#!/usr/bin/env bash
# Rendered by submit_job.sh (placeholders substituted) and passed as a new
# Launch Template version's UserData for a single job launch. Runs once at
# boot via cloud-init, as root.
set -euo pipefail

LOG_FILE=/var/log/doc-to-lora-job.log
LOG_S3_URI="s3://__S3_BUCKET__/__S3_PREFIX__/__JOB_TYPE__/__RUN_NAME__/logs/user-data.log"
LOG_SYNC_INTERVAL_SEC=15
LOG_SYNC_PID=""
exec > >(tee -a "$LOG_FILE") 2>&1

# Runs on every exit path -- success or an early `set -e` failure (bad docker
# login/pull/etc., before the job container ever starts) -- so a billed
# instance can never be left idling with no log ever reaching S3.
cleanup() {
    [[ -n "$LOG_SYNC_PID" ]] && kill "$LOG_SYNC_PID" 2>/dev/null || true
    if [[ -n "__S3_BUCKET__" ]]; then
        aws s3 cp "$LOG_FILE" "$LOG_S3_URI" || true
    fi
    shutdown -h now
}
trap cleanup EXIT

echo "[user-data] job=__JOB_TYPE__ run_name=__RUN_NAME__ image=__IMAGE_URI__"

AWS_REGION="__AWS_REGION__"
aws ecr get-login-password --region "$AWS_REGION" \
    | docker login --username AWS --password-stdin "$(echo __IMAGE_URI__ | cut -d/ -f1)"

docker pull "__IMAGE_URI__"

# Push the still-growing log to S3 every LOG_SYNC_INTERVAL_SEC while the job
# runs, so progress is visible before the final upload in cleanup() below --
# that one only happens once the container has already exited.
if [[ -n "__S3_BUCKET__" ]]; then
    ( while true; do
          sleep "$LOG_SYNC_INTERVAL_SEC"
          aws s3 cp "$LOG_FILE" "$LOG_S3_URI" || true
      done ) &
    LOG_SYNC_PID=$!
fi

# --ipc=host + large --shm-size: PyTorch DataLoader workers and NCCL rely on
# shared memory; Docker's 64MB default silently breaks multi-GPU/multi-worker
# jobs (see infra/README.md).
set +e
docker run --rm --gpus all \
    --ipc=host --ulimit memlock=-1 --ulimit stack=67108864 --shm-size=30g \
    -e JOB_TYPE="__JOB_TYPE__" \
    -e RUN_NAME="__RUN_NAME__" \
    -e S3_BUCKET="__S3_BUCKET__" \
    -e S3_PREFIX="__S3_PREFIX__" \
    -e HF_TOKEN="__HF_TOKEN__" \
    -e CONFIG_PATH="__CONFIG_PATH__" \
    "__IMAGE_URI__" __EXTRA_ARGS__
JOB_EXIT_CODE=$?
set -e

echo "[user-data] job exited with code ${JOB_EXIT_CODE}"

# One-shot job -- cleanup() (log-sync kill, final log upload, and
# `shutdown -h now`) runs automatically via the EXIT trap above. Requires the
# Launch Template's InstanceInitiatedShutdownBehavior=terminate (set in
# infra/launch-template.json) since Spot capacity can only be terminated
# anyway, not stopped.
